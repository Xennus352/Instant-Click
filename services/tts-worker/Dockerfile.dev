# TTS Worker Development Dockerfile
# Runs FastAPI app with model availability detection
# Uses ubuntu:22.04 base which has espeak-ng available

FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    wget \
    curl \
    dumb-init \
    libsndfile1 \
    espeak-ng \
    libespeak-ng1 \
    && rm -rf /var/lib/apt/lists/*

# Create python3 symlink
RUN ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /app

# Create non-root user (idempotent)
RUN if ! id appuser &>/dev/null; then useradd -m -u 1000 appuser; fi && \
    chown -R appuser:appuser /app

# Install Python dependencies
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# Copy application code
COPY app.py .

USER appuser

EXPOSE 8002

ENTRYPOINT ["dumb-init", "--"]

# Run FastAPI app with model availability detection
CMD ["python3", "app.py"]