# Next.js Development Dockerfile
# Hot reload enabled, source code bind-mounted

FROM node:22-alpine

# Install dependencies for native modules and health checks
RUN apk add --no-cache \
    wget \
    curl \
    dumb-init \
    openssl

# Supplied only for the local build when the host needs an HTTP proxy.
ARG npm_config_proxy
ARG npm_config_https_proxy

WORKDIR /app
RUN chown node:node /app
USER node

# Copy package files first for better caching
COPY --chown=node:node package*.json ./

# Install all dependencies (including devDependencies)
RUN npm ci

# Copy the rest of the application
COPY --chown=node:node . .

# Generate the MongoDB Prisma client during image build; the URL is only for schema config.
RUN DATABASE_URL="mongodb://localhost:27017/instantcap" npx prisma generate

# Create necessary directories
RUN mkdir -p .next public

EXPOSE 3000

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

# Start development server with hot reload
CMD ["npm", "run", "dev"]
