# InstantCap Environment Variables Template
# Copy to .env.dev for local use, then replace the placeholder credentials. Never commit .env.dev.
# NEVER commit actual secrets to version control!

# ============================================================
# APPLICATION
# ============================================================
APP_URL=http://localhost:3000
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# ============================================================
# DATABASE (MONGODB REPLICA SET)
# For Docker Compose, use matching Mongo root credentials below. For host-run Next.js, use localhost:27018.
# ============================================================
# Format: mongodb://[username:password@]host1[:port1][,host2[:port2],...][/database][?options]
DATABASE_URL=mongodb://replace_with_local_user:replace_with_local_password@mongodb-primary:27017/instantcap?replicaSet=rs0&authSource=admin
MONGO_INITDB_ROOT_USERNAME=replace_with_local_user
MONGO_INITDB_ROOT_PASSWORD=replace_with_local_password

# ============================================================
# REDIS
# Docker Compose service address; use localhost:6379 only for host-run Next.js.
# ============================================================
REDIS_URL=redis://redis:6379

# ============================================================
# OBJECT STORAGE (S3-COMPATIBLE)
# For Docker Compose: S3_ENDPOINT=http://minio:9000 and public endpoint=http://localhost:19002.
# ============================================================
# Internal endpoint (API -> S3 service). For DEV Compose: http://minio:9000
# For PROD: set the endpoint for your S3-compatible provider.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=replace_with_local_s3_access_key
S3_SECRET_KEY=replace_with_local_s3_secret_key
S3_BUCKET=instantcap
S3_REGION=us-east-1
S3_PUBLIC_HOSTNAME=localhost:19002

# Public endpoint for browser presigned URLs.
# In DEV Compose: http://localhost:19002 (host mapping to MinIO port 9000)
# In PROD: https://s3.yourdomain.com (or CDN URL)
S3_PUBLIC_ENDPOINT=http://localhost:19002

# Force path-style addressing (required for MinIO, optional for AWS S3)
S3_FORCE_PATH_STYLE=true

# ============================================================
# MinIO-compatible server credentials (development defaults only)
# Keep these equal to S3_ACCESS_KEY and S3_SECRET_KEY for the Compose MinIO service.
# ============================================================
MINIO_ROOT_USER=replace_with_local_s3_access_key
MINIO_ROOT_PASSWORD=replace_with_local_s3_secret_key

# ============================================================
# AUTHENTICATION (BETTER AUTH)
# ============================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-super-secret-auth-key-min-32-chars

# OAuth providers (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_EMAIL_FROM=InstantCap <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Internal API key shared by Next.js and trusted workers; generate separately per environment.
# Example: openssl rand -hex 32
INTERNAL_API_KEY=replace_with_unique_random_32_byte_key

# ============================================================
# AI PROVIDERS
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ============================================================
# MODEL PATHS (for workers)
# ============================================================
MODEL_CACHE_DIR=./model_cache
NARA_SAR_MODEL_PATH=/models/nara-sar/onnx/acoustic.onnx
NARA_MINI_MODEL_DIR=/models/nara-mini-v1

# ============================================================
# WORKER CONFIGURATION
# ============================================================
ORT_THREADS=4
ORT_PROVIDERS=CPUExecutionProvider
FFMPEG_THREADS=4

# ============================================================
# MONITORING
# ============================================================
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
GRAFANA_URL=http://localhost:3001

# ============================================================
# FEATURE FLAGS
# ============================================================
ENABLE_MOCK_AI=true
ENABLE_MOCK_ASR=true
ENABLE_MOCK_TTS=true
